{
  "name": "launchplay",
  "productName": "LaunchPlay",
  "version": "1.0.0",
  "description": "影游快启 (LaunchPlay) —— 把电脑变成电视式全屏大屏启动器，Windows / Linux 通用",
  "main": "src/main.js",
  "author": "Taby-Ding",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taby-Ding/launchplay.git"
  },
  "homepage": "https://github.com/Taby-Ding/launchplay#readme",
  "bugs": {
    "url": "https://github.com/Taby-Ding/launchplay/issues"
  },
  "keywords": [
    "electron",
    "launcher",
    "htpc",
    "tv",
    "windows",
    "macos",
    "linux",
    "kiosk",
    "remote-control",
    "media-center"
  ],
  "scripts": {
    "start": "electron .",
    "icon": "node tools/make-icon.js",
    "prepare-electron": "node tools/prepare-electron.js",
    "dist": "npm run dist:win",
    "dist:win": "node tools/prepare-electron.js && electron-builder --win portable --x64 --config.electronDist=build/electron-dist --publish never",
    "dist:win:setup": "node tools/prepare-electron.js && electron-builder --win nsis --x64 --config.electronDist=build/electron-dist --publish never",
    "dist:linux": "electron-builder --linux AppImage tar.gz --x64",
    "dist:mac": "electron-builder --mac zip --x64 --arm64",
    "dist:all": "npm run dist:win && npm run dist:linux && npm run dist:mac"
  },
  "devDependencies": {
    "electron": "38.2.2",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.launchplay.desktop",
    "productName": "LaunchPlay",
    "asar": true,
    "compression": "maximum",
    "afterPack": "tools/after-pack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "Taby-Ding",
        "repo": "launchplay"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/**/{test,__tests__,tests,example,examples,docs,doc}/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "LaunchPlay-${version}-windows-x64.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "LaunchPlay-${version}-windows-x64.${ext}",
      "unpackDirName": "LaunchPlay"
    },
    "nsis": {
      "artifactName": "LaunchPlay-${version}-windows-x64-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "影游快启",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh-CN",
        "en-US"
      ],
      "language": "2052"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.entertainment",
      "darkModeSupport": true,
      "artifactName": "LaunchPlay-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "LSMinimumSystemVersion": "11.0",
        "NSHighResolutionCapable": true
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "executableName": "launchplay",
      "synopsis": "把电脑变成电视式大屏启动器",
      "description": "全屏磁贴启动台，方向键 / 遥控器 / 鼠标都能操作",
      "artifactName": "LaunchPlay-${version}-linux-x64.${ext}",
      "desktop": {
        "entry": {
          "Name": "LaunchPlay",
          "Comment": "电视式全屏大屏启动器",
          "Categories": "AudioVideo;Player;Utility;"
        }
      }
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
